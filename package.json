{
  "name": "graphyloop",
  "version": "0.5.0",
  "description": "GraphyLoop is a one-command agentic workflow kit for AI coding agents: it wires Claude Code, OpenCode, Codex, Cursor, Gemini CLI, Oh My Pi and DeepSeek Harness with a 25-agent squad, parallel wave planning, persistent memory and an MCP server. Zero dependencies.",
  "type": "module",
  "author": "Richard Legaspi (https://github.com/chadixearth)",
  "homepage": "https://chadixearth.github.io/graphyloop/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chadixearth/graphyloop.git"
  },
  "bugs": {
    "url": "https://github.com/chadixearth/graphyloop/issues"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "agentic-workflow",
    "multi-agent",
    "swarm",
    "agent-memory",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code",
    "opencode",
    "codex",
    "cursor",
    "developer-tools",
    "cli",
    "gemini-cli",
    "oh-my-pi",
    "omp",
    "agents-md",
    "ai-coding-agent",
    "coding-agent",
    "subagents",
    "context-engineering",
    "agent-workflow",
    "workflow",
    "windsurf",
    "deepseek",
    "ai-memory",
    "claude",
    "llm",
    "devtools"
  ],
  "bin": {
    "graphyloop": "bin/graphyloop.mjs"
  },
  "scripts": {
    "setup": "node setup.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:fast": "node scripts/run-tests.mjs --fast",
    "test:list": "node scripts/run-tests.mjs --list",
    "test:engine": "node scripts/run-tests.mjs adapter",
    "test:secrets": "node scripts/run-tests.mjs secrets",
    "test:planner": "node scripts/run-tests.mjs planner",
    "test:mcp": "node scripts/run-tests.mjs mcp",
    "test:hotpath": "node scripts/run-tests.mjs hotpath",
    "test:plugin": "node scripts/run-tests.mjs plugin",
    "test:install": "node scripts/run-tests.mjs install",
    "test:update": "node scripts/run-tests.mjs update",
    "bench": "node scripts/bench-mcp.mjs",
    "pack": "npm pack",
    "prepublishOnly": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "files": [
    "setup.mjs",
    "bin",
    "lib",
    "templates",
    "mcp-server.mjs",
    "adapter/cli.mjs",
    "plugin",
    "agents",
    "skills",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!skills/last30days/assets/**",
    "workflow",
    "config",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ]
}
